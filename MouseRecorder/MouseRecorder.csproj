<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MouseRecorder</RootNamespace>
    <AssemblyName>MouseRecorder</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <WarningLevel>4</WarningLevel>
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>

  <!--
    This machine builds with Ubuntu's packaged (source-build) .NET 8 SDK, which does not
    include Microsoft.NET.Sdk.WindowsDesktop (no UseWindowsForms). Instead we reference the
    shared framework manually via FrameworkReference — this works identically on a target
    machine with the full official SDK (UseWindowsForms=true would also work there, but
    isn't required).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

</Project>
